{
    "name": "prestashop/payline",
    "description": "PrestaShop module payline",
    "type": "prestashop-module",
    "config": {
        "optimize-autoloader": true,
        "prepend-autoloader": false,
        "preferred-install": "dist"
    },
    "autoload-dev": {
        "psr-4": {
            "Monext\\Tests\\Unit\\": "tests/Unit/"
        }
    },
    "require": {
        "php": ">=7.4",
        "monext/monext-php": "25.9",
        "ddtraceweb/monolog-parser": "^1.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.5",
        "prestashop/php-dev-tools": "^5.0",
        "friendsofphp/php-cs-fixer": "^3.9",
        "phpstan/phpstan": "^2.2",
        "prestashop/header-stamp": "^3.1",
        "prestashop/autoindex": "^3.0",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "PrestaShop\\Module\\Payline\\": "src/"
        },
        "classmap": [
            "payline.php",
            "class/"
        ],
        "exclude-from-classmap": []
    }
}
